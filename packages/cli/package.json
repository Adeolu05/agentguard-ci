{
  "name": "@drainproof/cli",
  "version": "0.1.0",
  "description": "Drainproof: test whether an AI agent's proposed financial actions comply with explicit transaction policies.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "drainproof": "./dist/bin.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drainproof/core": "workspace:*",
    "@drainproof/runner": "workspace:*"
  },
  "peerDependencies": {
    "@drainproof/near": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@drainproof/near": {
      "optional": true
    }
  },
  "devDependencies": {
    "@drainproof/near": "workspace:*"
  }
}

# AgentGuard CI needs NO environment variables for policy validation, scenario runs or the
# dashboard demo. The variables below are optional.

# ── Dashboard (apps/web) ─────────────────────────────────────────────────────
# Directory containing CLI run reports (<runId>.json). Default: ./.agentguard/runs
AGENTGUARD_RUNS_DIR=
# Project file whose policy the Policy page validates live.
AGENTGUARD_PROJECT=
# Set to 1 to show the bundled demo reports (clearly labelled in the UI).
AGENTGUARD_DEMO=

# ── NEAR testnet execution (examples/near-testnet/demo.mjs) ──────────────────
# Execution is OFF unless this is exactly "testnet". Mainnet is not supported.
AGENTGUARD_NEAR_EXECUTION=
# A testnet account you control.
NEAR_TESTNET_ACCOUNT_ID=
# A TESTNET-ONLY key (ed25519:...). Never a mainnet key. Never commit it; use your secret store.
NEAR_TESTNET_PRIVATE_KEY=
# Optional; must be https. Default: https://test.rpc.fastnear.com
NEAR_TESTNET_RPC_URL=
# Demo only: the testnet account that receives 0.01 NEAR. Required when execution is
# enabled, and it must be listed in examples/near-testnet/policy.yaml. See docs/testnet-run.md.
RECIPIENT=

# ── AgentGuard Vault on testnet (examples/near-vault) ───────────────────────
# deploy.mjs and push-policy.mjs sign as the vault's owner with NEAR_TESTNET_ACCOUNT_ID and
# NEAR_TESTNET_PRIVATE_KEY above. add-agent-key.mjs signs once, during setup, as the agent
# account with the same two variables (its full-access key). The demo uses RECIPIENT above.
AGENTGUARD_VAULT_ACCOUNT_ID=
AGENTGUARD_AGENT_ACCOUNT_ID=
# The agent's FUNCTION-CALL key (testnet only), printed once by add-agent-key.mjs. It can only
# call request_payment on the vault. Never a full-access key.
AGENTGUARD_AGENT_PRIVATE_KEY=
# Optional: a public key for add-agent-key.mjs to add, instead of generating a key pair.
AGENTGUARD_AGENT_PUBLIC_KEY=
# Optional: NEAR moved into the vault at deployment (default 3) and the agent key's gas
# allowance in NEAR (default 0.25).
AGENTGUARD_VAULT_FUNDING=
AGENTGUARD_AGENT_ALLOWANCE=

# ── LLM prompt-injection demo (examples/llm-agent) ─────────────────────────
# Optional. Without a key the demo replays the recorded model responses offline.
# A NEAR AI Cloud API key (sk-...), from cloud.near.ai. Never commit it.
NEAR_AI_API_KEY=
# Optional: model (default z-ai/glm-5.3-flash) and base URL (default https://cloud-api.near.ai/v1).
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=
# Vault mode on testnet only: the allowlisted testnet account that receives the allowed payment.
AGENTGUARD_LLM_DATA_PROVIDER=

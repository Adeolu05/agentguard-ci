# AgentGuard CI needs NO environment variables for policy validation, scenario runs or the
# dashboard demo. The variables below are optional.

# ── Dashboard (apps/web) ─────────────────────────────────────────────────────
# Directory containing CLI run reports (<runId>.json). Default: ./.agentguard/runs
AGENTGUARD_RUNS_DIR=
# Project file whose policy the Policy page validates live.
AGENTGUARD_PROJECT=
# Set to 1 to show the bundled demo reports (clearly labelled in the UI).
AGENTGUARD_DEMO=

# ── NEAR testnet execution (examples/near-testnet/demo.mjs) ──────────────────
# Execution is OFF unless this is exactly "testnet". Mainnet is not supported.
AGENTGUARD_NEAR_EXECUTION=
# A testnet account you control.
NEAR_TESTNET_ACCOUNT_ID=
# A TESTNET-ONLY key (ed25519:...). Never a mainnet key. Never commit it; use your secret store.
NEAR_TESTNET_PRIVATE_KEY=
# Optional; must be https. Default: https://test.rpc.fastnear.com
NEAR_TESTNET_RPC_URL=
# Demo only: the testnet account that receives 0.01 NEAR. Required when execution is
# enabled, and it must be listed in examples/near-testnet/policy.yaml. See docs/testnet-run.md.
RECIPIENT=

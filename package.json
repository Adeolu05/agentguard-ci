{
  "name": "drainproof-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:web": "pnpm --filter @drainproof/web build",
    "typecheck": "pnpm build && pnpm build:web && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:vault": "pnpm --filter @drainproof/example-near-vault build:contract",
    "test:vault": "pnpm --filter @drainproof/example-near-vault test:sandbox",
    "drainproof": "node packages/cli/dist/bin.js",
    "check": "pnpm lint && pnpm build && pnpm build:web && pnpm -r typecheck && pnpm test",
    "dashboard:demo": "pnpm build && pnpm build:web && DRAINPROOF_DEMO=1 pnpm --filter @drainproof/web start",
    "pack:local": "bash scripts/pack-local.sh",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
